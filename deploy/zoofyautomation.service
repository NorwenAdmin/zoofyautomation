[Unit]
Description=Zoofy Automation FastAPI App
After=network.target docker.service

[Service]
Type=simple
WorkingDirectory=/opt/zoofyautomation/backend
ExecStart=/opt/zoofyautomation/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
