    "/api/subscriptions": {
      "post": {
        "tags": [
          "subscriptions"
        ],
        "summary": "Create Subscription Invoice",
        "description": "n8n calls this once per parsed email. Upsert on `factuur` so a re-processed email\n(e.g. label didn't stick, workflow re-run) never creates a duplicate row — n8n doesn't\nneed to check for existing rows itself before posting.",
        "operationId": "create_subscription_invoice_api_subscriptions_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
