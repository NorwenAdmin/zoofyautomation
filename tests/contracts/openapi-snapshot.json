    "/api/bookkeeping/compare": {
      "get": {
        "tags": [
          "bookkeeping"
        ],
        "summary": "Compare Bookkeeping",
        "description": "Diffs facturen (from Zoofy's emails) against bookkeeping_entries (pulled from Kees)\nso n8n can flag invoices Zoofy issued that the accountant hasn't entered yet. Matches on\nfactuur/invoice_number, factuur/file_name, or kenmerk/invoice_number — Kees's invoice_number\nsometimes actually holds the Kenmerk value instead of the real invoice number, and file_name\nstays factuur-shaped even then, so no single field pairing is reliable on its own.\nBoth sides are sorted by date descending (most recent first) so the frontend's two lists\ndon't come back in arbitrary insertion order.",
        "operationId": "compare_bookkeeping_api_bookkeeping_compare_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookkeepingCompareOut"
                }
              }
            }
          }
        }
      }
    }
