                  },
                  "title": "Response List Facturen Api Facturen Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/facturen/{factuur_id}": {
      "patch": {
        "tags": [
          "facturen"
        ],
        "summary": "Update Factuur",
        "description": "n8n calls this once the PDF's text layer has been parsed for the job details that only\nlive in the PDF, not the email body (Klusnummer/Klusomschrijving/Klusadres) — a separate\ncall from create_factuur since PDF extraction happens on a parallel branch after the row\nalready exists, not before.",
        "operationId": "update_factuur_api_facturen__factuur_id__patch",
        "parameters": [
          {
            "name": "factuur_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Factuur Id"
