          }
        }
      }
    },
    "/api/appointments/{klusnummer}/cancel": {
      "post": {
        "tags": [
          "appointments"
        ],
        "summary": "Cancel Appointment",
        "description": "n8n calls this once per cancellation email. Cancellation and confirmation emails can\narrive in either order, so this creates a bare stub row if the klusnummer isn't known yet —\nthe confirmation upsert above fills in the visit details later if it comes in after.",
        "operationId": "cancel_appointment_api_appointments__klusnummer__cancel_post",
        "parameters": [
          {
            "name": "klusnummer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Klusnummer"
            }
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AppointmentCancelIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppointmentOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/facturen": {
      "post": {
        "tags": [
          "facturen"
        ],
        "summary": "Create Factuur",
        "description": "n8n calls this once per parsed invoice email. Upsert on (factuur, totaal) together —\na repeat of the exact same invoice+amount is a re-processed email, skip it; the same\nfactuur with a DIFFERENT amount is a genuine discrepancy the original sheet flagged\ninstead of silently overwriting, so it's kept as its own row (frontend can spot these by\ngrouping on `factuur` and checking for >1 distinct `totaal`).",
        "operationId": "create_factuur_api_facturen_post",
        "parameters": [
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Api-Key"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FactuurIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactuurOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "facturen"
        ],
        "summary": "List Facturen",
        "operationId": "list_facturen_api_facturen_get",
